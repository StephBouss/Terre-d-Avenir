# Sur Vercel, l’intégration Neon crée DATABASE_URL : elle est reprise telle quelle si DATABASE_URI est absente.
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5433/terredavenir
# 32 caractères aléatoires au moins (le déploiement Vercel s’arrête sinon).
PAYLOAD_SECRET=remplacer-par-une-chaine-aleatoire-de-32-caracteres
# En ligne, sans cette variable : l’adresse de production Vercel du projet.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Compte administrateur créé par le seed. Au premier déploiement (base vide), le mot de passe doit faire 12 caractères au moins.
SEED_ADMIN_EMAIL=admin@terredavenir.local
SEED_ADMIN_PASSWORD=changer-ce-mot-de-passe
PREVIEW_SECRET=remplacer-par-une-chaine-aleatoire

# Envoi des e-mails (SMTP). Sans SMTP_HOST, aucun e-mail ne part : les formulaires restent enregistrés dans « Messages reçus ».
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur : « Nom <adresse@exemple.org> » ou une adresse seule.
SMTP_FROM=
# Développement local uniquement (Mailpit, port 1025) : 1 désactive l’exigence de STARTTLS.
# SMTP_INSECURE=1

# En ligne : stockage des photos compatible S3 (Neon Object Storage : Connect > Storage > Parameters only). Obligatoire sur Vercel.
# Correspondance avec Neon : AWS_ENDPOINT_URL_S3 → S3_ENDPOINT, AWS_REGION → S3_REGION, AWS_ACCESS_KEY_ID → S3_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY → S3_SECRET_ACCESS_KEY (Vercel réserve les noms AWS_*). S3_BUCKET : le nom du bucket créé chez Neon.
# Sans ces variables, les photos restent dans le dossier media/ (développement local).
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
